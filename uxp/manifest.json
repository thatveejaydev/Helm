{
  "manifestVersion": 5,
  "id": "is.helm.palette.bridge",
  "name": "Helm Bridge",
  "version": "0.1.5",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0",
    "data": { "loadEvent": "startup" }
  },
  "entrypoints": [{
    "type": "panel",
    "id": "helmBridge",
    "label": { "default": "Helm Bridge" },
    "minimumSize": { "width": 270, "height": 285 },
    "preferredDockedSize": { "width": 300, "height": 310 },
    "preferredFloatingSize": { "width": 340, "height": 320 }
  }],
  "icons": [
    {
      "width": 24,
      "height": 24,
      "path": "icons/icon.png"
    }
  ],
  "requiredPermissions": {
    "network": { "domains": ["ws://localhost/", "http://localhost/", "ws://localhost:48139"] },
    "launchProcess": {
      "schemes": ["helm"],
      "extensions": [".exe"]
    }
  }
}
